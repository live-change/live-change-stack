{
  "name": "@live-change/db-backend-benchmark",
  "version": "0.9.227",
  "description": "Backend contract tests, benchmarks and stress for @live-change/db stores",
  "type": "module",
  "main": "bin/run.js",
  "bin": {
    "lc-db-backend-benchmark": "./bin/run.js"
  },
  "scripts": {
    "test": "node bin/run.js --backend lmdb,memory --suite wiring,contract,consistency,durability,table",
    "bench": "node bin/run.js --backend lmdb,memory --suite bench --size 10000",
    "stress": "node bin/run.js --backend lmdb,memory --suite stress --size 10000",
    "fragment": "node bin/run.js --backend lmdb,memory,leveldb,rocksdb,sqlite --suite bench/fragmentation --timeout 600000 --size 10000",
    "fragment:10g": "node bin/run.js --backend lmdb,leveldb,rocksdb,sqlite --suite bench/fragmentation --timeout 14400000 --size 500000 --map-size 68719476736",
    "fragment:report": "node bin/render-fragmentation-report.js",
    "churn": "node bin/run.js --backend lmdb,memory,leveldb,rocksdb,sqlite --suite bench/churn --timeout 3600000 --size 10000",
    "churn:big": "node bin/run.js --backend lmdb,leveldb,rocksdb,sqlite --suite bench/churn --timeout 14400000 --size 100000 --map-size 68719476736",
    "churn:4x": "node bin/run.js --backend lmdb,leveldb,rocksdb,sqlite --suite bench/churn --timeout 28800000 --size 400000 --map-size 137438953472 --json report-2.json",
    "churn:report": "node bin/render-churn-report.js",
    "churn:report:2": "node bin/render-churn-report.js --report report-2.json --suffix 2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/live-change/live-change-stack.git"
  },
  "author": {
    "email": "m8@em8.pl",
    "name": "Michał Łaszczewski",
    "url": "https://www.viamage.com/"
  },
  "license": "MIT",
  "dependencies": {
    "@live-change/db": "0.9.229",
    "@live-change/db-server": "0.9.229",
    "@live-change/db-store-level": "0.9.229",
    "@live-change/db-store-lmdb": "0.9.229",
    "@live-change/db-store-rbtree": "0.9.229",
    "@live-change/db-store-rocksdb": "0.9.229",
    "@live-change/db-store-sqlite": "0.9.229",
    "memdown": "^6.1.1",
    "rimraf": "^5.0.5",
    "yargs": "^17.7.2"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.10.0",
    "leveldown": "^6.1.0",
    "rocksdb": "^5.2.1"
  }
}
